table 'Incidents Core'
	lineageTag: 4dcb38af-476c-472b-a97c-38b3fd193327

	measure 'Sum of Response Times' = (SUM('Incidents Core'[Response Time PSAP To Arrival]))
		formatString: 0
		lineageTag: 89b911f6-5776-4050-9b9d-ebeac122c52a

	measure 'Average Response Time' = AVERAGE('Incidents Core'[Response Time Alarm To Arrival])
		lineageTag: 824b0cd1-b5bb-4e59-92a9-eb292d109e32

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Response Time (mm:ss)' = ```
			
			VAR TotalSeconds = 
			    AVERAGE('Incidents Core'[Response Time Alarm To Arrival])
			VAR Minutes = INT(TotalSeconds / 60)
			VAR Seconds = MOD(TotalSeconds, 60)
			RETURN 
			    FORMAT(Minutes, "0") & ":" & FORMAT(Seconds, "00")
			```
		lineageTag: b8c03545-539f-4a9d-a7a7-617a469cb35f

	measure 'Average 3M Rolling' = ```
			
			VAR _CurrentDate = TODAY()
			VAR _EndDate = EOMONTH(_CurrentDate, -1)
			VAR _StartDate = EOMONTH(_CurrentDate, -3)
			VAR _Average = CALCULATE(
			    AVERAGE('Incidents Core'[Response Time Alarm To Arrival]),
			        'Incidents Core'[Alarm Date] >= _StartDate && 'Incidents Core'[Alarm Date] <= _EndDate
			        )
			VAR Minutes = INT(_Average / 60)
			VAR Seconds = MOD(_Average, 60)
			RETURN 
			    FORMAT(Minutes, "0") & ":" & FORMAT(Seconds, "00")
			```
		lineageTag: 8966ecaf-03ca-4958-8325-b4fc57bca026

	measure 'Average Incidents per Month' = CALCULATE(count('Incidents Core'[IncidentID]))
		formatString: 0
		lineageTag: a19fa038-d214-4d4b-9672-33dcb08c931f

